# Copy to .env and fill in. Used by docker-compose.yml (production).

# Public domain name. Point its DNS at this server; Caddy gets the certificate.
ACF_DOMAIN=localhost

# Caddy's host ports (default 80 and 443), e.g. a local port for a tunnel or another proxy in front.
# ACF_HTTP_PORT=127.0.0.1:8088
# ACF_HTTPS_PORT=127.0.0.1:8443
# When that tunnel or proxy terminates HTTPS, make Caddy serve plain HTTP (no certificate, no redirect):
# ACF_CADDY_ADDRESS=:80

# Database password (PostgreSQL runs in its own container). Pick a long random string.
POSTGRES_PASSWORD=

# Encrypts secrets in the database (users' API keys, MCP configurations, OAuth tokens). Required.
# Generate with `openssl rand -base64 48`; keep it out of database backups and never change it.
ACF_SECRET_KEY=

# Model. Default is Claude; any LangChain provider works (see README).
# This key is the server's: every user who hasn't added their own key in Settings uses it (and your
# bill). It is only ever sent to this provider and address. Leave it empty to make users bring a key.
ANTHROPIC_API_KEY=
# ACF_LLM_PROVIDER=openai
# ACF_LLM_MODEL=gpt-4.1-mini
# ACF_LLM_BASE_URL=http://ollama:11434/v1
# ACF_LLM_API_KEY=
# Providers users may pick (comma-separated LangChain ids; "*" = any). Default: providers that take an
# API key, so users can't make the server use its own cloud credentials (e.g. bedrock).
# ACF_LLM_PROVIDERS=anthropic,openai
# The models users can pick, with effort levels and token windows (JSON list; see README), and whether users
# may add models of their own.
# ACF_MODELS_FILE=/data/models.json
# ACF_CUSTOM_MODELS=true
# Sub-agents: how many work at once per chat (0 = off), and the model the agent gets when it asks for a "fast" one.
# ACF_SUBAGENTS=8
# ACF_SUBAGENT_FAST_MODEL=claude-haiku-5-5

# Main account, created at startup (its password is reset to this on every start).
# ACF_ADMIN_EMAIL=you@example.com
# ACF_ADMIN_PASSWORD=
# ACF_ADMIN_NAME=

# Open sign-ups. Default: open, or closed when ACF_ADMIN_EMAIL is set.
# ACF_ALLOW_SIGNUP=false

# Images: published by the release workflow under this Docker Hub user, at this tag. Pin a full version
# (2.0.0) or follow a line: 2.0 (patches), 2 (minor releases), latest (newest stable). See docs/releasing.md.
ACF_REGISTRY=alfredfrancis
ACF_VERSION=2.0.0-beta.1

# Absolute host path for data (database + workspaces). Default: ./data next to this file.
# ACF_DATA_PATH=/srv/ai-chatbot-framework/data

# Sandboxes: their own network (inter-container traffic off; deploy/sandbox-firewall.sh blocks private
# and metadata addresses on its bridge). "none" cuts them off from the internet.
ACF_SANDBOX_NETWORK=acf-sandbox
# ACF_SANDBOX_BRIDGE=acf-sbx0
# gVisor by default; install it on the host first (deploy/README.md). "runc" opts out.
# ACF_SANDBOX_RUNTIME=runsc
