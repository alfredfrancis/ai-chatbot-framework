{
  "name": "ai-chatbot-framework-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-tokens.mjs && node scripts/build-app-prompt.mjs && vite",
    "build": "node scripts/build-tokens.mjs && node scripts/build-app-prompt.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test --trace off",
    "tokens": "node scripts/build-tokens.mjs",
    "app-prompt": "node scripts/build-app-prompt.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@openuidev/react-lang": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "@openuidev/lang-core": "1.0.1"
  }
}
