		"app/bot/dialogue_manager/dialogue_manager.py-simstep-ffad7c66-8cb8-4c16-8106-4fa246f7ee0f": {
			"path": "app/bot/dialogue_manager/dialogue_manager.py-simstep-ffad7c66-8cb8-4c16-8106-4fa246f7ee0f",
			"fileName": "dialogue_manager.py",
			"wiki": "After processing the user's message, the DialogueManager identifies the intent and extracts all necessary parameters (e.g., 'order_number'). It verifies that the intent is complete (no more questions to ask the user), and then checks if it's configured to trigger an API call.",
			"cellName": "Intent Fulfillment and API Trigger Check - dialogue_manager.py:L167-171",
			"cellId": "de676713-8ec4-47eb-becf-64a55c43aa5e",
			"visible": true,
			"startLine": 167,
			"endLine": 171,
			"parentCellId": "075664cf-5e28-4fa1-8879-33b7168373f9",
			"parentPath": "app/bot/dialogue_manager/dialogue_manager.py",
			"simSteps": [
				{
					"simulationKey": "Integrate with External Systems via API Calls",
					"simStepId": "ffad7c66-8cb8-4c16-8106-4fa246f7ee0f"
				}
			]
		},
		"4e17adff-a3f0-4fd1-b44e-7a5d96a19bd6": {
			"path": "4e17adff-a3f0-4fd1-b44e-7a5d96a19bd6",
			"cellName": "Initiate API Call - dialogue_manager.py:L309-311",
			"cellId": "4e17adff-a3f0-4fd1-b44e-7a5d96a19bd6",
			"visible": true,
			"parentCellId": "075664cf-5e28-4fa1-8879-33b7168373f9"
		},
		"app/bot/dialogue_manager/dialogue_manager.py-simstep-f9f27dce-d529-4582-ab57-ba422fb6909d": {
			"path": "app/bot/dialogue_manager/dialogue_manager.py-simstep-f9f27dce-d529-4582-ab57-ba422fb6909d",
			"fileName": "dialogue_manager.py",
			"wiki": "The `_handle_api_trigger` method confirms that the intent has an API trigger enabled (`api_trigger` is true) and that API details are present. It then calls the `_call_intent_api` function to perform the actual HTTP request.",
			"cellName": "Initiate API Call - dialogue_manager.py:L309-311",
			"cellId": "4e17adff-a3f0-4fd1-b44e-7a5d96a19bd6",
			"visible": true,
			"startLine": 309,
			"endLine": 311,
			"parentCellId": "075664cf-5e28-4fa1-8879-33b7168373f9",
			"parentPath": "app/bot/dialogue_manager/dialogue_manager.py",
			"simSteps": [
				{
					"simulationKey": "Integrate with External Systems via API Calls",
					"simStepId": "f9f27dce-d529-4582-ab57-ba422fb6909d"
				}
			]
		},
		"993c3e80-b397-41f1-9605-1fb838260e91": {
			"path": "993c3e80-b397-41f1-9605-1fb838260e91",
			"cellName": "Prepare and Execute External API Call - dialogue_manager.py:L353-379",
			"cellId": "993c3e80-b397-41f1-9605-1fb838260e91",
			"visible": true,
			"parentCellId": "075664cf-5e28-4fa1-8879-33b7168373f9"
		},
		"app/bot/dialogue_manager/dialogue_manager.py-simstep-9209bf70-1d98-46ed-b509-712950d6f64c": {
			"path": "app/bot/dialogue_manager/dialogue_manager.py-simstep-9209bf70-1d98-46ed-b509-712950d6f64c",
			"fileName": "dialogue_manager.py",
			"wiki": "The `_call_intent_api` method uses Jinja2 to render the API URL with the extracted `order_number` parameter. It then constructs and sends the HTTP GET request to the external service.",
			"cellName": "Prepare and Execute External API Call - dialogue_manager.py:L353-379",
			"cellId": "993c3e80-b397-41f1-9605-1fb838260e91",
			"visible": true,
			"startLine": 353,
			"endLine": 379,
			"parentCellId": "075664cf-5e28-4fa1-8879-33b7168373f9",
			"parentPath": "app/bot/dialogue_manager/dialogue_manager.py",
			"simSteps": [
				{
					"simulationKey": "Integrate with External Systems via API Calls",
					"simStepId": "9209bf70-1d98-46ed-b509-712950d6f64c"
				}
			]
		},
		"09d71198-5193-42b7-8366-a60d0b1d144e": {
			"path": "09d71198-5193-42b7-8366-a60d0b1d144e",
			"cellName": "Generate Final Bot Response - dialogue_manager.py:L312-321",
			"cellId": "09d71198-5193-42b7-8366-a60d0b1d144e",
			"visible": true,
			"parentCellId": "075664cf-5e28-4fa1-8879-33b7168373f9"
		},
		"app/bot/dialogue_manager/dialogue_manager.py-simstep-fc2e8a06-179a-4290-8e54-0eff87872c12": {
			"path": "app/bot/dialogue_manager/dialogue_manager.py-simstep-fc2e8a06-179a-4290-8e54-0eff87872c12",
			"fileName": "dialogue_manager.py",
			"wiki": "The `_handle_api_trigger` method receives the API result. It then uses Jinja2 to render the intent's `speech_response` template, inserting the status from the API result and the order number from the conversation parameters to create the final, dynamic message for the user.",
			"cellName": "Generate Final Bot Response - dialogue_manager.py:L312-321",
			"cellId": "09d71198-5193-42b7-8366-a60d0b1d144e",
			"visible": true,
			"startLine": 312,
			"endLine": 321,
			"parentCellId": "075664cf-5e28-4fa1-8879-33b7168373f9",
			"parentPath": "app/bot/dialogue_manager/dialogue_manager.py",
			"simSteps": [
				{
					"simulationKey": "Integrate with External Systems via API Calls",
					"simStepId": "fc2e8a06-179a-4290-8e54-0eff87872c12"
				}
			]
		},
		"e1077feb-a2cd-4d4f-bc65-7a05f1f5d67a": {
			"path": "e1077feb-a2cd-4d4f-bc65-7a05f1f5d67a",
			"cellName": "Save State and Finalize Response - dialogue_manager.py:L178-182",
			"cellId": "e1077feb-a2cd-4d4f-bc65-7a05f1f5d67a",
			"visible": true,
			"parentCellId": "075664cf-5e28-4fa1-8879-33b7168373f9"
		},
		"app/bot/dialogue_manager/dialogue_manager.py-simstep-37c7c49f-4ff6-40a0-9fee-e5efb125685f": {
			"path": "app/bot/dialogue_manager/dialogue_manager.py-simstep-37c7c49f-4ff6-40a0-9fee-e5efb125685f",
			"fileName": "dialogue_manager.py",
			"wiki": "The `process` method receives the final state, saves it to persistent memory (e.g., MongoDB), and returns the state object. The web framework serializes this object, and the bot's message is sent back to the user.",
			"cellName": "Save State and Finalize Response - dialogue_manager.py:L178-182",
			"cellId": "e1077feb-a2cd-4d4f-bc65-7a05f1f5d67a",
			"visible": true,
			"startLine": 178,
			"endLine": 182,
