							"{{ .Values.image.tag }}",
							"{{ .Values.mongodb.uri }}"
						]
					},
					"inputDataExample": "{\"template\": \"deployment-backend.yaml\", \"values\": {\"image\": {\"backend\": {\"repository\": \"my-repo/backend\"}, \"tag\": \"v1.0.0\"}, \"mongodb\": {\"uri\": \"mongodb://mongo:27017/chatbot\"}}}",
					"outputDataExample": "{\"manifest\": \"apiVersion: apps/v1\\nkind: Deployment\\nmetadata:\\n  name: ai-chatbot-framework-backend\\nspec:\\n  replicas: 1\\n  template:\\n    spec:\\n      containers:\\n      - name: ai-chatbot-framework\\n        image: my-repo/backend:v1.0.0\\n        env:\\n        - name: MONGO_URL\\n          value: mongodb://mongo:27017/chatbot\"}"
				},
				{
					"simStepId": "a745fe90-4236-469b-8223-b18d28e3624f",
