		"Integrate with External Systems via API Calls": {
			"name": "Integrate with External Systems via API Calls",
			"simSteps": [
				{
					"simStepId": "ffad7c66-8cb8-4c16-8106-4fa246f7ee0f",
					"diagramNodeId": "de676713-8ec4-47eb-becf-64a55c43aa5e",
					"simStepLabel": "Intent Fulfillment and API Trigger Check",
					"simStepDescription": "After processing the user's message, the DialogueManager identifies the intent and extracts all necessary parameters (e.g., 'order_number'). It verifies that the intent is complete (no more questions to ask the user), and then checks if it's configured to trigger an API call.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "167",
						"endLine": "171",
						"relevantVariables": [
							"current_state",
							"active_intent",
							"_process_intent",
							"_handle_api_trigger",
							"current_state.complete"
						]
					},
					"inputDataExample": "{\"message\": {\"thread_id\": \"user_session_123\", \"text\": \"What is the status of my order ORD123456?\"}}",
					"outputDataExample": "{\"current_state\": {\"thread_id\": \"user_session_123\", \"user_message\": {\"text\": \"What is the status of my order ORD123456?\"}, \"intent\": {\"id\": \"check_order_status\"}, \"extracted_parameters\": {\"order_number\": \"ORD123456\"}, \"missing_parameters\": [], \"complete\": true, \"bot_message\": []}}"
				},
				{
					"simStepId": "c77618cc-354f-4b9d-bc07-e87c68bd9f07",
					"diagramNodeId": "1f80c183-b8b8-4663-bb32-d49c3723bec9",
					"simStepLabel": "Transmit State to API Handler",
					"simStepDescription": "The main process flow passes the fully populated conversation state and the matched intent details to the `_handle_api_trigger` method to execute the external API call.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "170",
						"endLine": "170",
						"relevantVariables": [
							"_handle_api_trigger",
							"active_intent",
							"current_state"
						]
					},
					"inputDataExample": "{\"active_intent\": {\"name\": \"Check Order Status\", \"intent_id\": \"check_order_status\", \"api_trigger\": true, ...}, \"current_state\": {\"thread_id\": \"user_session_123\", \"complete\": true, \"extracted_parameters\": {\"order_number\": \"ORD123456\"}, ...}}",
					"outputDataExample": "{\"active_intent\": {\"name\": \"Check Order Status\", \"intent_id\": \"check_order_status\", \"api_trigger\": true, ...}, \"current_state\": {\"thread_id\": \"user_session_123\", \"complete\": true, \"extracted_parameters\": {\"order_number\": \"ORD123456\"}, ...}}"
				},
				{
					"simStepId": "f9f27dce-d529-4582-ab57-ba422fb6909d",
					"diagramNodeId": "4e17adff-a3f0-4fd1-b44e-7a5d96a19bd6",
					"simStepLabel": "Initiate API Call",
					"simStepDescription": "The `_handle_api_trigger` method confirms that the intent has an API trigger enabled (`api_trigger` is true) and that API details are present. It then calls the `_call_intent_api` function to perform the actual HTTP request.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "309",
						"endLine": "311",
						"relevantVariables": [
