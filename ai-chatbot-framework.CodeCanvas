			]
		},
		"f585fc73-51bd-47e4-b70e-71990885dab3": {
			"path": "f585fc73-51bd-47e4-b70e-71990885dab3",
			"cellName": "Runtime Flow: Prepare Prompt and Processing Chain - zero_shot_nlu_openai.py:L45-63",
			"cellId": "f585fc73-51bd-47e4-b70e-71990885dab3",
			"visible": true,
			"parentCellId": "9dcd017e-f2f1-4677-9adb-b32956ba9702"
