		"app/bot/nlu/pipeline_utils.py-simstep-57c8fcb9-3617-4578-bbba-5d215a25ffad": {
			"path": "app/bot/nlu/pipeline_utils.py-simstep-57c8fcb9-3617-4578-bbba-5d215a25ffad",
			"fileName": "pipeline_utils.py",
			"wiki": "The `create_zero_shot_pipeline` function instantiates the `NLUPipeline` with the `ZeroShotNLUOpenAI` component. It gathers all existing intent and entity names to be passed to the component, which will be used in the prompt.",
			"cellName": "Runtime Flow: Instantiate ZeroShotNLUOpenAI Component - pipeline_utils.py:L83-89",
			"cellId": "f25cd075-941a-4a1b-a16c-7b739a86a9ee",
