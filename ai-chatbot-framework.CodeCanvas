		"app/admin/train/routes.py-simstep-10215a55-64e9-4229-87fe-77fcb620c41c": {
			"path": "app/admin/train/routes.py-simstep-10215a55-64e9-4229-87fe-77fcb620c41c",
			"fileName": "routes.py",
			"wiki": "The FastAPI backend receives the request at the `/train/build_models` endpoint. To avoid blocking the server, it schedules the `build_models_background` function to run as a background task and immediately returns a confirmation response.",
			"cellName": "Backend Receives Training Request - routes.py:L46-51",
			"cellId": "e928555d-67d9-4265-b166-c76148f14003",
			"visible": true,
