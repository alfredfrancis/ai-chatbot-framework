					"outputDataExample": "{\"current_state\": {\"thread_id\": \"user_session_123\", \"complete\": true, \"extracted_parameters\": {\"order_number\": \"ORD123456\"}, \"bot_message\": [{\"text\": \"Your order status is <b>Shipped</b> and is expected to arrive in 2-3 business days.\"}], ...}}"
