		"app/bot/dialogue_manager/dialogue_manager.py-simstep-282d060a-3db4-454b-8428-95c8f6b9537a": {
			"path": "app/bot/dialogue_manager/dialogue_manager.py-simstep-282d060a-3db4-454b-8428-95c8f6b9537a",
			"fileName": "dialogue_manager.py",
			"wiki": "Since no previous state was found, the `DialogueManager` initializes a new `State` object for the `thread_id`. This new state is then updated with the current user message.",
			"cellName": "Initialize New State - dialogue_manager.py:L107-111",
			"cellId": "b05ffcb5-1ee9-4905-b65c-867f625e2d7f",
