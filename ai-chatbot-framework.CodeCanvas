					"inputDataExample": "{\"thread_id\": \"user_12345\", \"intent\": \"order_pizza\", \"parameters\": [], \"extracted_parameters\": {}, \"missing_parameters\": [\"pizza_size\", \"pizza_topping\"], \"complete\": false, \"bot_message\": [{\"text\": \"What size pizza would you like?\"}]}",
					"outputDataExample": "{\"thread_id\": \"user_12345\", \"intent\": \"order_pizza\", \"parameters\": [], \"extracted_parameters\": {}, \"missing_parameters\": [\"pizza_size\", \"pizza_topping\"], \"complete\": false, \"bot_message\": [{\"text\": \"What size pizza would you like?\"}]}"
				},
