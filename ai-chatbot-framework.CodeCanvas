					},
					"inputDataExample": "{\n  \"base_url\": \"http://host.docker.internal:11434/v1\",\n  \"api_key\": \"ollama\",\n  \"model_name\": \"llama3\",\n  \"temperature\": 0.1,\n  \"max_tokens\": 4096\n}",
					"outputDataExample": "{\n  \"base_url\": \"http://host.docker.internal:11434/v1\",\n  \"api_key\": \"ollama\",\n  \"model_name\": \"llama3\",\n  \"temperature\": 0.1,\n  \"max_tokens\": 4096\n}"
