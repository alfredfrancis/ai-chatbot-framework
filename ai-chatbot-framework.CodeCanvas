					"inputDataExample": "{\"api_details\": {\"url\": \"https://fake-store-api.mock.beeceptor.com/api/orders/status?order_id={{ parameters['order_number'] }}\", \"request_type\": \"GET\", ...}, \"current_state\": {\"extracted_parameters\": {\"order_number\": \"ORD123456\"}}}",
					"outputDataExample": "{\"id\": \"ORD123456\", \"status\": \"Shipped\", \"estimated_delivery\": \"2023-10-28\"}"
				},
				{
