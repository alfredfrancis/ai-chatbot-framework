							"current_state",
							"query_intent",
							"active_intent"
						]
					},
					"inputDataExample": "{\"current_state\": {\"thread_id\": \"user_12345\", \"intent\": \"order_pizza\", \"confidence\": 0.98, \"entities\": [], \"user_message\": \"I want to order a pizza\"}}",
					"outputDataExample": "{\"current_state\": {\"thread_id\": \"user_12345\", \"intent\": \"order_pizza\", \"confidence\": 0.98, \"entities\": [], \"user_message\": \"I want to order a pizza\"}}"
				},
				{
					"simStepId": "0129d5cd-2319-49f8-b1dd-b06c31ec5b3c",
					"diagramNodeId": "01b6a08e-3352-4da6-9379-1ae529c43e54",
					"simStepLabel": "Identify Missing Parameters for Intent",
					"simStepDescription": "The system compares the required parameters for the 'order_pizza' intent (`pizza_size`, `pizza_topping`) with the extracted parameters from the user's message (none). It identifies that `pizza_size` is missing and prepares a prompt.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "271",
						"endLine": "295",
						"relevantVariables": [
							"_handle_missing_parameters",
							"parameters",
							"current_state",
							"missing_params"
						]
					},
					"inputDataExample": "{\"required_parameters\": [{\"name\": \"pizza_size\", \"prompt\": \"What size pizza would you like?\"}, {\"name\": \"pizza_topping\", \"prompt\": \"What toppings?\"}], \"extracted_parameters\": {}}",
					"outputDataExample": "{\"missing_parameters\": [\"pizza_size\", \"pizza_topping\"], \"bot_message\": [{\"text\": \"What size pizza would you like?\"}]}"
				},
				{
					"simStepId": "86d94e50-0c30-4678-aeb4-cd3ebbb0be72",
					"diagramNodeId": "576a8357-e9bf-4db4-b54f-ede5824f81bf",
					"simStepLabel": "Update State with Bot Response",
					"simStepDescription": "The `current_state` object is updated to reflect the new conversational turn. `missing_parameters` is populated, `complete` is set to `false`, and `bot_message` is set to the prompt for the user.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "268",
						"endLine": "269",
						"relevantVariables": [
							"current_state.complete",
							"current_state.missing_parameters"
						]
					},
					"inputDataExample": "{\"thread_id\": \"user_12345\", \"intent\": \"order_pizza\", \"missing_parameters\": [\"pizza_size\", \"pizza_topping\"], \"complete\": false, \"bot_message\": [{\"text\": \"What size pizza would you like?\"}]}",
					"outputDataExample": "{\"thread_id\": \"user_12345\", \"intent\": \"order_pizza\", \"missing_parameters\": [\"pizza_size\", \"pizza_topping\"], \"complete\": false, \"bot_message\": [{\"text\": \"What size pizza would you like?\"}]}"
				},
				{
					"simStepId": "1c0b14e9-d62e-45ce-b735-fca2db5e4abb",
					"diagramNodeId": "4ab09ac8-a1cf-497c-8d75-e23dc3519e40",
					"simStepLabel": "Persist Updated Conversation State",
					"simStepDescription": "Before returning the response, the `DialogueManager` saves the complete, updated state of the conversation to the memory store, ensuring context is maintained for the user's next message.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "161",
