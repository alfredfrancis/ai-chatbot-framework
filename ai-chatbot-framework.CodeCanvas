		"app/bot/dialogue_manager/dialogue_manager.py-simstep-b4e084f4-4b06-4439-bab1-09cbe2500b60": {
			"path": "app/bot/dialogue_manager/dialogue_manager.py-simstep-b4e084f4-4b06-4439-bab1-09cbe2500b60",
			"fileName": "dialogue_manager.py",
			"wiki": "The `reload_dialogue_manager` function is called, which in turn calls the `update_model` method on the active `DialogueManager` instance. This method instructs the NLU pipeline to load the newly created model files from the disk, making them immediately available for processing user input.",
			"cellName": "Reload Dialogue Manager with New Models - dialogue_manager.py:L78-84",
			"cellId": "24a9c7b3-075b-4a9c-84bc-6f12591b62e5",
			"visible": true,
