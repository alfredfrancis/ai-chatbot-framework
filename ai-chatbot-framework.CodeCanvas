					"outputDataExample": "{\"intent\": {\"intent_id\": \"check_order_status\", \"api_details\": {\"url\": \"https://fake-store-api.mock.beeceptor.com/api/orders/status?order_id={{ parameters['order_number'] }}\", \"request_type\": \"GET\", ...}}, \"current_state\": {\"extracted_parameters\": {\"order_number\": \"ORD123456\"}, ...}}"
				},
				{
					"simStepId": "9209bf70-1d98-46ed-b509-712950d6f64c",
					"diagramNodeId": "993c3e80-b397-41f1-9605-1fb838260e91",
					"simStepLabel": "Prepare and Execute External API Call",
					"simStepDescription": "The `_call_intent_api` method uses Jinja2 to render the API URL with the extracted `order_number` parameter. It then constructs and sends the HTTP GET request to the external service.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "353",
						"endLine": "379",
