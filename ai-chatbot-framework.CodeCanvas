		},
		"c91697ba-29c8-4f43-ae1a-eb12c998e897": {
			"path": "c91697ba-29c8-4f43-ae1a-eb12c998e897",
			"cellName": "Process Message and Return Full State - routes.py:L27-30",
			"cellId": "c91697ba-29c8-4f43-ae1a-eb12c998e897",
			"visible": true,
			"parentCellId": "af6927ba-1f83-40fc-b6ff-4fd79915d641"
		},
		"app/admin/test/routes.py-simstep-b103ffc2-434e-4f9a-8eb3-6e1e70057007": {
			"path": "app/admin/test/routes.py-simstep-b103ffc2-434e-4f9a-8eb3-6e1e70057007",
			"fileName": "routes.py",
			"wiki": "The `DialogueManager` processes the message through the NLU pipeline, updates the conversation memory, generates a response, and packages the entire state of the conversation into a `ChatState` object. This object is then converted to a dictionary and returned as the API response.",
			"cellName": "Process Message and Return Full State - routes.py:L27-30",
			"cellId": "c91697ba-29c8-4f43-ae1a-eb12c998e897",
			"visible": true,
			"startLine": 27,
			"endLine": 30,
			"parentCellId": "af6927ba-1f83-40fc-b6ff-4fd79915d641",
			"parentPath": "app/admin/test/routes.py",
			"simSteps": [
				{
					"simulationKey": "Test and Debug the Chatbot in Real-Time",
					"simStepId": "b103ffc2-434e-4f9a-8eb3-6e1e70057007"
				}
			]
		},
		"60c3093c-05a5-4540-acc7-9f45008bc441": {
