					"outputDataExample": "{\"id\": \"ORD123456\", \"status\": \"Shipped\", \"estimated_delivery\": \"2023-10-28\"}"
				},
				{
					"simStepId": "fc2e8a06-179a-4290-8e54-0eff87872c12",
					"diagramNodeId": "09d71198-5193-42b7-8366-a60d0b1d144e",
					"simStepLabel": "Generate Final Bot Response",
					"simStepDescription": "The `_handle_api_trigger` method receives the API result. It then uses Jinja2 to render the intent's `speech_response` template, inserting the status from the API result and the order number from the conversation parameters to create the final, dynamic message for the user.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "312",
						"endLine": "321",
