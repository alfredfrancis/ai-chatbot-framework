					"simStepLabel": "Pass Details for API Execution",
					"simStepDescription": "The intent model and current conversation state, containing the API URL template and extracted parameters, are passed to the `_call_intent_api` method.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "311",
