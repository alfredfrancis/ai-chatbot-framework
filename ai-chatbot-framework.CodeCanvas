					"simStepLabel": "Write State to MongoDB",
					"simStepDescription": "The `MemorySaverMongo` instance serializes the `State` object to a dictionary and inserts it as a new document into the `state` collection in MongoDB.",
					"isEdge": 1,
					"sourceCodeMapping": {
