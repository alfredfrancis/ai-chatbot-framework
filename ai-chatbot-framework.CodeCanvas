					"inputDataExample": "{\"intent\": {\"speech_response\": \"Your order status is <b>{{ result.status }}</b> and is expected to arrive in 2-3 business days.\"}, \"current_state\": {\"extracted_parameters\": {\"order_number\": \"ORD123456\"}}, \"result\": {\"status\": \"Shipped\"}}",
					"outputDataExample": "{\"current_state\": {\"bot_message\": [{\"text\": \"Your order status is <b>Shipped</b> and is expected to arrive in 2-3 business days.\"}]}}"
