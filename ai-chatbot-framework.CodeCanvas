					},
					"inputDataExample": "{\"chart_path\": \"helm/ai-chatbot-framework\"}",
					"outputDataExample": "{\"chart_path\": \"helm/ai-chatbot-framework\"}"
				},
				{
					"simStepId": "d93b68b8-4db1-4ad6-a9a8-50284b9fd6fe",
					"diagramNodeId": "65ed6fc0-be3e-4fb3-9e65-d30540201ecb",
					"simStepLabel": "Flow 2 (Kubernetes/Helm): Render Kubernetes Manifests",
					"simStepDescription": "Helm's rendering engine combines the templates (e.g., `deployment-backend.yaml`) with configuration values (from `values.yaml`) to generate the final Kubernetes resource manifests as YAML strings.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "helm/ai-chatbot-framework/templates/deployment-backend.yaml",
						"startLine": "1",
