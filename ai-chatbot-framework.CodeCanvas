		"app/bot/nlu/entity_extractors/crf_entity_extractor.py-simstep-0fbdb850-2a43-4128-ab48-eb0e8606c95f": {
			"path": "app/bot/nlu/entity_extractors/crf_entity_extractor.py-simstep-0fbdb850-2a43-4128-ab48-eb0e8606c95f",
			"fileName": "crf_entity_extractor.py",
			"wiki": "The `CRFEntityExtractor` converts the annotated examples into a format suitable for CRF training, creating features and BIO (Beginning, Inside, Outside) labels for each token. It then trains a Conditional Random Fields model using `pycrfsuite` and saves the resulting model to `crf_entity_extractor.model`.",
			"cellName": "Train Entity Extractor Model - crf_entity_extractor.py:L89-111",
			"cellId": "e5448a08-dd01-466d-a801-db401812e9fe",
			"visible": true,
			"startLine": 89,
			"endLine": 111,
			"parentCellId": "1b07cd70-b9e3-462a-8b17-d2782f810e84",
			"parentPath": "app/bot/nlu/entity_extractors/crf_entity_extractor.py",
			"simSteps": [
				{
					"simulationKey": "Train the NLU to Understand User Input",
					"simStepId": "0fbdb850-2a43-4128-ab48-eb0e8606c95f"
				}
			]
		},
		"24a9c7b3-075b-4a9c-84bc-6f12591b62e5": {
			"path": "24a9c7b3-075b-4a9c-84bc-6f12591b62e5",
			"cellName": "Reload Dialogue Manager with New Models - dialogue_manager.py:L78-84",
