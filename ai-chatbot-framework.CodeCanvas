		"app/bot/nlu/pipeline_utils.py-simstep-be9bf7ae-8fbf-46b8-85fc-214cc619f023": {
			"path": "app/bot/nlu/pipeline_utils.py-simstep-be9bf7ae-8fbf-46b8-85fc-214cc619f023",
			"fileName": "pipeline_utils.py",
			"wiki": "The `train_pipeline` function gathers all intents and their corresponding training examples from the database. It aggregates them into a single `training_data` list, the standard format required by all NLU pipeline components.",
			"cellName": "Prepare Training Data - pipeline_utils.py:L24-34",
			"cellId": "1f6d190f-97f5-44a8-8b30-cc0162383b01",
			"visible": true,
			"startLine": 24,
			"endLine": 34,
			"parentCellId": "5f46f5c7-5e33-46a1-951f-a9d30acdc3dd",
