		"app/bot/nlu/featurizers/spacy_featurizer.py-simstep-9b3d3291-4a69-4aff-a86b-0af872f32031": {
			"path": "app/bot/nlu/featurizers/spacy_featurizer.py-simstep-9b3d3291-4a69-4aff-a86b-0af872f32031",
			"fileName": "spacy_featurizer.py",
			"wiki": "The `SpacyFeaturizer` processes each training sentence. It tokenizes the text and generates a `spacy_doc` object, which includes word vectors and other linguistic features. This `spacy_doc` is added to each training example dictionary for use by downstream components.",
			"cellName": "Spacy Featurization - spacy_featurizer.py:L13-17",
			"cellId": "7ab3f335-c424-46b1-944d-31639498d5fe",
			"visible": true,
			"startLine": 13,
			"endLine": 17,
			"parentCellId": "fb6bfedc-b2c0-4ed5-93a2-b5c8f7fd41cf",
			"parentPath": "app/bot/nlu/featurizers/spacy_featurizer.py",
			"simSteps": [
				{
					"simulationKey": "Train the NLU to Understand User Input",
					"simStepId": "9b3d3291-4a69-4aff-a86b-0af872f32031"
				}
			]
		},
		"b2e5b313-6bd3-46f1-8129-9ab0cb62b96a": {
			"path": "b2e5b313-6bd3-46f1-8129-9ab0cb62b96a",
			"cellName": "Train Intent Classifier Model - sklearn_intent_classifer.py:L28-66",
			"cellId": "b2e5b313-6bd3-46f1-8129-9ab0cb62b96a",
			"visible": true,
			"parentCellId": "b59c6f76-31d0-4ee7-95c6-90ed54094f17"
