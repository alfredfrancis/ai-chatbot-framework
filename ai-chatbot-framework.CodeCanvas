			"path": "app/bot/dialogue_manager/dialogue_manager.py-simstep-c5a1392a-fd10-43a1-a7f0-29ec01518bd4",
			"fileName": "dialogue_manager.py",
			"wiki": "The `DialogueManager` attempts to retrieve the most recent state for the given `thread_id` from the configured memory store. This is the first step in recalling the conversation's context.",
			"cellName": "Retrieve Previous Conversation State - dialogue_manager.py:L104-105",
