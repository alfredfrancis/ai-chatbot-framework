		"app/admin/bots/schemas.py-simstep-c997cf6b-98d9-41ad-ab7c-c30a0a39d8b2": {
			"path": "app/admin/bots/schemas.py-simstep-c997cf6b-98d9-41ad-ab7c-c30a0a39d8b2",
			"fileName": "schemas.py",
			"wiki": "The backend receives the new configuration. Using Pydantic models defined in `schemas.py`, it validates the incoming data and persists it to the database for the 'default' bot.",
