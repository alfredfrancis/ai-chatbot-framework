							"self.memory_saver.init_state",
							"current_state.update"
						]
					},
					"inputDataExample": "{\"thread_id\": \"user_12345\", \"user_message\": {\"text\": \"I want to order a pizza\"}}",
					"outputDataExample": "{\"thread_id\": \"user_12345\", \"intent\": null, \"parameters\": [], \"extracted_parameters\": {}, \"missing_parameters\": [], \"complete\": true}"
				},
				{
					"simStepId": "f0e28c97-3720-4579-bb00-0fc2948d3f85",
					"diagramNodeId": "2af8620c-5e64-4ed8-92e1-377df93aac68",
					"simStepLabel": "Pass State to Intent Processor",
					"simStepDescription": "After NLU processing identifies the 'order_pizza' intent, the state object, now containing the NLU results, is passed to the intent processing logic to handle parameter extraction and slot-filling.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "200",
						"endLine": "207",
						"relevantVariables": [
