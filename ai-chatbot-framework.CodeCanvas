		"Manage Multi-Turn Conversations and Context": {
			"name": "Manage Multi-Turn Conversations and Context",
			"simSteps": [
				{
					"simStepId": "29f5eb1d-5066-4d18-b05e-da22c7103ccf",
					"diagramNodeId": "f4ea6092-c89b-434b-9e7a-dfd47102c5dc",
					"simStepLabel": "Receive User Message via REST API",
					"simStepDescription": "An HTTP POST request is received at the `/rest/webbook` endpoint. The request body contains the user's message, a unique thread_id for the conversation, and any additional context.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "app/bot/channels/rest/routes.py",
						"startLine": "13",
						"endLine": "22",
						"relevantVariables": [
							"router",
							"webbook",
							"body",
							"dialogue_manager"
						]
					},
					"inputDataExample": "{\"method\": \"POST\", \"url\": \"/rest/webbook\", \"body\": {\"thread_id\": \"user_12345\", \"text\": \"I want to order a pizza\", \"context\": {}}}",
					"outputDataExample": "{\"thread_id\": \"user_12345\", \"text\": \"I want to order a pizza\", \"context\": {}}"
				},
				{
					"simStepId": "e6c546d5-9883-4291-b419-ff24f90672e3",
					"diagramNodeId": "a061bca2-b7e9-4445-a791-4a2dfcf08f01",
					"simStepLabel": "Forward Message to Dialogue Manager",
					"simStepDescription": "The REST API handler constructs a `UserMessage` object from the request body and passes it to the `DialogueManager`'s `process` method for handling the core conversational logic.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "app/bot/channels/rest/routes.py",
						"startLine": "24",
						"endLine": "28",
						"relevantVariables": [
							"user_message",
							"dialogue_manager.process"
						]
					},
					"inputDataExample": "{\"user_message\": {\"thread_id\": \"user_12345\", \"text\": \"I want to order a pizza\", \"context\": {}}}",
					"outputDataExample": "{\"user_message\": {\"thread_id\": \"user_12345\", \"text\": \"I want to order a pizza\", \"context\": {}}}"
				},
				{
					"simStepId": "c5a1392a-fd10-43a1-a7f0-29ec01518bd4",
					"diagramNodeId": "700afb2d-e962-4a40-9895-dab20bdbc4f3",
					"simStepLabel": "Retrieve Previous Conversation State",
					"simStepDescription": "The `DialogueManager` attempts to retrieve the most recent state for the given `thread_id` from the configured memory store. This is the first step in recalling the conversation's context.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "104",
						"endLine": "105",
						"relevantVariables": [
							"self.memory_saver",
							"message.thread_id",
							"current_state"
						]
					},
					"inputDataExample": "{\"thread_id\": \"user_12345\"}",
					"outputDataExample": "null"
				},
				{
					"simStepId": "9dd003ec-3545-4b55-879b-a6c7b95ab5db",
					"diagramNodeId": "4dce0644-af18-4ea1-a88b-2a054fe0358b",
					"simStepLabel": "Query State from MongoDB",
					"simStepDescription": "The `MemorySaverMongo` instance executes a `find_one` query against the `state` collection in MongoDB to find the latest document matching the `thread_id`. Since this is the first message, the query returns no results.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "app/bot/memory/memory_saver_mongo.py",
						"startLine": "21",
						"endLine": "25",
						"relevantVariables": [
							"self.collection.find_one",
							"thread_id"
						]
					},
					"inputDataExample": "{\"query\": {\"filter\": {\"thread_id\": \"user_12345\"}, \"sort\": [[\"$natural\", -1]], \"projection\": {\"_id\": 0, \"nlu\": 0, \"date\": 0, \"user_message\": 0, \"bot_message\": 0}}}",
					"outputDataExample": "{\"query\": {\"filter\": {\"thread_id\": \"user_12345\"}, \"sort\": [[\"$natural\", -1]], \"projection\": {\"_id\": 0, \"nlu\": 0, \"date\": 0, \"user_message\": 0, \"bot_message\": 0}}}"
				},
				{
					"simStepId": "282d060a-3db4-454b-8428-95c8f6b9537a",
					"diagramNodeId": "b05ffcb5-1ee9-4905-b65c-867f625e2d7f",
					"simStepLabel": "Initialize New State",
					"simStepDescription": "Since no previous state was found, the `DialogueManager` initializes a new `State` object for the `thread_id`. This new state is then updated with the current user message.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "app/bot/dialogue_manager/dialogue_manager.py",
						"startLine": "107",
						"endLine": "111",
						"relevantVariables": [
