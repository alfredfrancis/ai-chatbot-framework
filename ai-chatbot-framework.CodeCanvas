			"visible": true,
			"parentCellId": "af6927ba-1f83-40fc-b6ff-4fd79915d641"
		},
		"app/admin/test/routes.py-simstep-c0196212-a606-4e32-8300-f2ffe7b9e427": {
			"path": "app/admin/test/routes.py-simstep-c0196212-a606-4e32-8300-f2ffe7b9e427",
			"fileName": "routes.py",
			"wiki": "The FastAPI backend receives the POST request at the `/test/chat` endpoint. It parses the JSON body, creates a `UserMessage` model instance, and prepares to hand it off to the core logic.",
