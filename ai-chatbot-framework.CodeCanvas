		"app/bot/nlu/pipeline_utils.py-simstep-81d1cec7-6d52-42e2-ad3f-ac4fc302c3c8": {
			"path": "app/bot/nlu/pipeline_utils.py-simstep-81d1cec7-6d52-42e2-ad3f-ac4fc302c3c8",
			"fileName": "pipeline_utils.py",
			"wiki": "When a user sends a message, the system needs to process it. The `get_pipeline` function is called, which first fetches the bot's NLU configuration from the database. Based on the `pipeline_type`, it determines which pipeline to create.",
			"cellName": "Runtime Flow: Load NLU Pipeline - pipeline_utils.py:L44-45",
			"cellId": "550b5287-1407-46d0-9f14-7f4c806a65ab",
