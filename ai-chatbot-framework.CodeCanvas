		"app/bot/nlu/intent_classifiers/sklearn_intent_classifer.py-simstep-5544ac13-0d6c-41f4-a84e-0a3c5abf5e11": {
			"path": "app/bot/nlu/intent_classifiers/sklearn_intent_classifer.py-simstep-5544ac13-0d6c-41f4-a84e-0a3c5abf5e11",
			"fileName": "sklearn_intent_classifer.py",
			"wiki": "The `SklearnIntentClassifier` extracts the `spacy_doc` vectors (features) and intent labels from the training data. It uses a Support Vector Machine (SVM) with `GridSearchCV` to train a robust intent classification model, which is then serialized and saved to `sklearn_intent_model.hd5`.",
			"cellName": "Train Intent Classifier Model - sklearn_intent_classifer.py:L28-66",
			"cellId": "b2e5b313-6bd3-46f1-8129-9ab0cb62b96a",
			"visible": true,
			"startLine": 28,
			"endLine": 66,
			"parentCellId": "b59c6f76-31d0-4ee7-95c6-90ed54094f17",
			"parentPath": "app/bot/nlu/intent_classifiers/sklearn_intent_classifer.py",
			"simSteps": [
				{
					"simulationKey": "Train the NLU to Understand User Input",
					"simStepId": "5544ac13-0d6c-41f4-a84e-0a3c5abf5e11"
				}
			]
		},
		"e5448a08-dd01-466d-a801-db401812e9fe": {
			"path": "e5448a08-dd01-466d-a801-db401812e9fe",
			"cellName": "Train Entity Extractor Model - crf_entity_extractor.py:L89-111",
			"cellId": "e5448a08-dd01-466d-a801-db401812e9fe",
			"visible": true,
			"parentCellId": "1b07cd70-b9e3-462a-8b17-d2782f810e84"
