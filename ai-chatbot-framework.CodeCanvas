					"inputDataExample": "{\"intent\": {\"intent_id\": \"check_order_status\", \"api_trigger\": true, \"api_details\": {\"url\": \"https://fake-store-api.mock.beeceptor.com/api/orders/status?order_id={{ parameters['order_number'] }}\", ...}}, \"current_state\": {\"extracted_parameters\": {\"order_number\": \"ORD123456\"}, ...}}",
					"outputDataExample": "{\"result\": {\"id\": \"ORD123456\", \"status\": \"Shipped\", \"estimated_delivery\": \"2023-10-28\"}}"
				},
