		"app/bot/nlu/llm/zero_shot_nlu_openai.py-simstep-bb7cb95f-3793-4046-8662-7b0a03aec16a": {
			"path": "app/bot/nlu/llm/zero_shot_nlu_openai.py-simstep-bb7cb95f-3793-4046-8662-7b0a03aec16a",
			"fileName": "zero_shot_nlu_openai.py",
			"wiki": "The component loads a prompt template from a file, injects the list of possible intents and entities, and combines the prompt, the LLM client, and a JSON output parser into a single processing chain using LangChain Expression Language (LCEL).",
			"cellName": "Runtime Flow: Prepare Prompt and Processing Chain - zero_shot_nlu_openai.py:L45-63",
			"cellId": "f585fc73-51bd-47e4-b70e-71990885dab3",
			"visible": true,
			"startLine": 45,
			"endLine": 63,
			"parentCellId": "9dcd017e-f2f1-4677-9adb-b32956ba9702",
			"parentPath": "app/bot/nlu/llm/zero_shot_nlu_openai.py",
			"simSteps": [
				{
					"simulationKey": "Utilize LLMs for Zero-Shot NLU",
					"simStepId": "bb7cb95f-3793-4046-8662-7b0a03aec16a"
				}
			]
		},
		"d691a4a1-c9c5-4192-8820-6567eff7f60c": {
			"path": "d691a4a1-c9c5-4192-8820-6567eff7f60c",
			"cellName": "Runtime Flow: Annotate Message with LLM Response - zero_shot_nlu_openai.py:L95-104",
			"cellId": "d691a4a1-c9c5-4192-8820-6567eff7f60c",
			"visible": true,
			"parentCellId": "9dcd017e-f2f1-4677-9adb-b32956ba9702"
