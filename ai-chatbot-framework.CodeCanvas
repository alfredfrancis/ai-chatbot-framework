					},
					"inputDataExample": "{\"api_endpoint\": \"https://kube-api.example.com/apis/apps/v1/namespaces/ai-chatbot-framework/deployments\", \"payload\": \"apiVersion: apps/v1\\nkind: Deployment\\n...\"}",
					"outputDataExample": "{\"api_endpoint\": \"https://kube-api.example.com/apis/apps/v1/namespaces/ai-chatbot-framework/deployments\", \"payload\": \"apiVersion: apps/v1\\nkind: Deployment\\n...\"}"
				},
				{
