		"app/bot/nlu/llm/zero_shot_nlu_openai.py-simstep-3c1bfdd8-1714-4663-b334-f27a4568c83c": {
			"path": "app/bot/nlu/llm/zero_shot_nlu_openai.py-simstep-3c1bfdd8-1714-4663-b334-f27a4568c83c",
			"fileName": "zero_shot_nlu_openai.py",
			"wiki": "The LLM returns a JSON string, which is parsed by `JsonOutputParser`. The `process` method then extracts the intent and entities from the parsed result and adds them to the message object, completing the NLU step.",
			"cellName": "Runtime Flow: Annotate Message with LLM Response - zero_shot_nlu_openai.py:L95-104",
			"cellId": "d691a4a1-c9c5-4192-8820-6567eff7f60c",
