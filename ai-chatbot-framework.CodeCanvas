					"outputDataExample": "[{\"text\": \"What's the status of my order ORD123456?\", \"entities\": [{\"value\": \"ORD123456\", \"begin\": 30, \"end\": 39, \"name\": \"order_number\"}], \"intent\": \"check_order_status\", \"spacy_doc\": \"<SpacyDoc object>\"}, {\"text\": \"hello there\", \"entities\": [], \"intent\": \"init_conversation\", \"spacy_doc\": \"<SpacyDoc object>\"}]"
