					"simStepLabel": "Signal Training Completion",
					"simStepDescription": "After the `train_pipeline` successfully executes for all components, control returns to the `build_models_background` function, which proceeds to reload the newly trained models into the live application.",
					"isEdge": 1,
					"sourceCodeMapping": {
