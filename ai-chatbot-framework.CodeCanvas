							"current_state"
						]
					},
					"inputDataExample": "{\"thread_id\": \"user_12345\", \"intent\": \"order_pizza\", \"missing_parameters\": [\"pizza_size\", \"pizza_topping\"], \"complete\": false, \"bot_message\": [{\"text\": \"What size pizza would you like?\"}]}",
					"outputDataExample": "{\"status\": \"success\"}"
				},
				{
					"simStepId": "a9983c8c-72df-4cdd-a623-e99c3dac2418",
