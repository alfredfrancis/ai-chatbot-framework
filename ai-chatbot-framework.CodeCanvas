					"simulationKey": "Train the NLU to Understand User Input",
					"simStepId": "be9bf7ae-8fbf-46b8-85fc-214cc619f023"
				}
			]
		},
		"6a79cb41-3ec5-43d0-9aba-218385543009": {
			"path": "6a79cb41-3ec5-43d0-9aba-218385543009",
			"cellName": "NLU Pipeline Training Loop - pipeline.py:L38-43",
			"cellId": "6a79cb41-3ec5-43d0-9aba-218385543009",
			"visible": true,
			"parentCellId": "55d60715-b30c-4dec-ad82-79f6eb5d01c9"
		},
		"app/bot/nlu/pipeline.py-simstep-7f2dda76-88b3-4971-93e1-5e8172412605": {
			"path": "app/bot/nlu/pipeline.py-simstep-7f2dda76-88b3-4971-93e1-5e8172412605",
			"fileName": "pipeline.py",
			"wiki": "The `NLUPipeline`'s `train` method iterates through its components. For each component, it calls its respective `train` method, passing along the training data. This ensures each part of the NLU model is trained in sequence.",
			"cellName": "NLU Pipeline Training Loop - pipeline.py:L38-43",
			"cellId": "6a79cb41-3ec5-43d0-9aba-218385543009",
			"visible": true,
			"startLine": 38,
			"endLine": 43,
			"parentCellId": "55d60715-b30c-4dec-ad82-79f6eb5d01c9",
			"parentPath": "app/bot/nlu/pipeline.py",
			"simSteps": [
				{
					"simulationKey": "Train the NLU to Understand User Input",
					"simStepId": "7f2dda76-88b3-4971-93e1-5e8172412605"
				}
			]
		},
		"7ab3f335-c424-46b1-944d-31639498d5fe": {
			"path": "7ab3f335-c424-46b1-944d-31639498d5fe",
			"cellName": "Spacy Featurization - spacy_featurizer.py:L13-17",
			"cellId": "7ab3f335-c424-46b1-944d-31639498d5fe",
