		"Self-Host and Deploy the Entire Framework": {
			"name": "Self-Host and Deploy the Entire Framework",
			"simSteps": [
				{
					"simStepId": "73b1dec5-d21d-45da-938e-f5d5e814f2e8",
					"diagramNodeId": "b211f233-4f26-4133-91e9-297f7f380678",
					"simStepLabel": "Flow 1 (Docker Compose): Initiate Development Environment Setup",
					"simStepDescription": "A developer initiates the local development environment setup by running the `docker-compose` command, pointing to the development-specific configuration file.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "CONTRIBUTING.md",
						"startLine": "28",
						"endLine": "30",
						"relevantVariables": [
							"docker-compose -f docker-compose.dev.yml up -d"
						]
					},
					"inputDataExample": "{\"command\": \"docker-compose -f docker-compose.dev.yml up -d\"}",
					"outputDataExample": "{\"status\": \"success\", \"message\": \"Creating network 'ai-chatbot-framework-dev_default' ... done. Creating mongodb ... done. Creating app ... done. Creating frontend ... done.\"}"
				},
				{
					"simStepId": "e581e0c1-05f2-4102-8981-d64a9f3c7bfb",
					"diagramNodeId": "8d9a0c79-140d-494e-a723-ff8ba5806ad0",
					"simStepLabel": "Flow 1 (Docker Compose): Transmit Configuration to Docker Engine",
					"simStepDescription": "The `docker-compose` command reads the `docker-compose.dev.yml` file and transmits the service definitions (mongodb, app, frontend) to the Docker engine for processing.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "docker-compose.dev.yml",
						"startLine": "3",
						"endLine": "41",
						"relevantVariables": [
							"services"
						]
					},
					"inputDataExample": "{\"services\": {\"mongodb\": {\"image\": \"mongo:4.2.20\"}, \"app\": {\"build\": {\"context\": \".\", \"dockerfile\": \"Dockerfile\"}}, \"frontend\": {\"build\": {\"context\": \"./frontend\", \"dockerfile\": \"dev.Dockerfile\"}, \"ports\": [\"3000:3000\"]}}}",
					"outputDataExample": "{\"services\": {\"mongodb\": {\"image\": \"mongo:4.2.20\"}, \"app\": {\"build\": {\"context\": \".\", \"dockerfile\": \"Dockerfile\"}}, \"frontend\": {\"build\": {\"context\": \"./frontend\", \"dockerfile\": \"dev.Dockerfile\"}, \"ports\": [\"3000:3000\"]}}}"
				},
				{
					"simStepId": "9343f74f-28b7-4c7c-ba46-2cb02d021e42",
					"diagramNodeId": "cc5c10b6-931a-440c-8bdf-5ab8cc0b062d",
					"simStepLabel": "Flow 1 (Docker Compose): Build Service Images",
					"simStepDescription": "The Docker engine processes the build instructions for each service. For the 'frontend' service, it uses the 'dev.Dockerfile' within the './frontend' directory to build a new Docker image.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "docker-compose.dev.yml",
						"startLine": "31",
						"endLine": "33",
						"relevantVariables": [
							"build",
							"context",
							"dockerfile"
						]
					},
					"inputDataExample": "{\"build_instruction\": {\"context\": \"./frontend\", \"dockerfile\": \"dev.Dockerfile\"}}",
					"outputDataExample": "{\"image_id\": \"sha256:f2a8f8e1e4b4\", \"status\": \"Build successful\"}"
				},
				{
					"simStepId": "d2ff65a8-84ab-4b45-bd7d-163ad39800ff",
					"diagramNodeId": "4be1b1ae-d5f0-4c98-b355-39d608e9da3e",
					"simStepLabel": "Flow 1 (Docker Compose): Store Built Image",
					"simStepDescription": "The newly built frontend image is tagged (e.g., 'ai-chatbot-framework-dev_frontend:latest') and stored in the local Docker image registry, making it available to create containers from.",
					"isEdge": 1,
					"sourceCodeMapping": {
