# Development image for the API and the fake model. Source is bind-mounted; uvicorn reloads on change.
FROM docker:29-cli AS dockercli

FROM python:3.12-slim
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app/backend
COPY backend/ ./
RUN pip install --no-cache-dir -e ".[dev]"
EXPOSE 8000
CMD ["uvicorn", "acf.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
